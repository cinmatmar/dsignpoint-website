---
import Layout from '../../../layouts/Layout.astro';

const ld = [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dsignpoint.com/"}, {"@type": "ListItem", "position": 2, "name": "Case studies", "item": "https://dsignpoint.com/case-studies/"}, {"@type": "ListItem", "position": 3, "name": "PadelCreations", "item": "https://dsignpoint.com/case-studies/padelcreations/"}]}];
---
<Layout title="PadelCreations case study | DsignPoint" description="From a heavy, declining website to a fast, AI-boosted lead-generation platform: the PadelCreations project by DsignPoint." path="/case-studies/padelcreations/" ogImage="/uploads/cs/pc_hero_bg.jpg"   jsonld={ld}>


<div style="position:relative;overflow-x:hidden;">
<section style="position:relative;min-height:min(94vh,880px);display:flex;flex-direction:column;color:oklch(97% 0.012 70);overflow:hidden;"><img src="../../uploads/cs/pc_hero_bg.jpg" alt="A padel court at sunset with glass walls, palm trees and mountains" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"><div style="position:absolute;inset:0;background:linear-gradient(180deg, oklch(15% 0.05 20 / 0.78) 0%, oklch(15% 0.05 20 / 0.55) 40%, oklch(12% 0.06 18 / 0.95) 100%);"></div>    <div style="position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(20px,5vw,56px);width:100%;max-width:1200px;margin:0 auto;">
      <a href="../.." class="dp-logo" aria-label="DsignPoint home"><span style="display:flex;align-items:center;gap:12px;"><img src="../../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:48px;width:auto;display:block;"><img src="../../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:24px;width:auto;display:block;"></span></a>
      <button type="button" class="dp-burger" aria-label="Open menu" aria-expanded="false" aria-controls="dp-nav"><span></span><span></span></button><div id="dp-nav" role="navigation" aria-label="Main" class="dp-nav-links" style="display:flex;align-items:center;gap:clamp(14px,2vw,30px);font-size:13px;letter-spacing:0.06em;text-transform:uppercase;">
        <a href="../.." style="color:oklch(88% 0.015 60);">Home</a>
        <a href="../../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
        <a href=".." style="color:oklch(88% 0.015 60);">Case Studies</a>
        <a href="../../insights/" style="color:oklch(88% 0.015 60);">Insights</a>
        <a href="../../about/" style="color:oklch(88% 0.015 60);">About</a>
        <a href="../../book-a-call/" style="display:inline-flex;align-items:center;gap:10px;border:1px solid oklch(83% 0.05 80);background:oklch(83% 0.05 80);color:oklch(24% 0.11 15);padding:12px 24px;font-weight:600;box-shadow:0 8px 28px oklch(83% 0.05 80 / 0.35);transition:background 0.35s ease, border-color 0.35s ease, gap 0.35s ease;" class="h1">Book a call <span aria-hidden="true">→</span></a>
      </div>
    </div>

<div style="position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%;max-width:1200px;margin:0 auto;padding:clamp(48px,8vh,96px) clamp(20px,5vw,56px) clamp(32px,5vh,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 20px;">Case study · Digital strategy, website &amp; SEO</p><h1 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,5.3vw,72px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(36px,6vh,64px);max-width:20ch;">From a heavy, declining website to a fast, AI-boosted lead-generation platform.</h1><div style="margin:0 0 clamp(36px,6vh,64px);"><a target="_blank" rel="noopener" href="http://padelcreations.com/" style="display:inline-flex;align-items:center;gap:12px;background:oklch(97% 0.012 70);color:oklch(33% 0.14 17);padding:17px 36px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;font-weight:500;transition:background 0.35s ease, gap 0.35s ease;" class="h2">Visit the live website <span aria-hidden="true">→</span></a></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px clamp(20px,3vw,40px);"><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Client</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">PadelCreations S.L., Spain</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Industry</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Padel court construction &amp; installation</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Markets</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">International B2B, with a focus on Europe including Germany</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Services</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Digital strategy · Information architecture · UX/UI · Development · Multilingual SEO</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Platforms</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">WordPress · Elementor Pro · Yoast SEO · Zoho CRM</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Launch</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">November 2026</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Overview</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,3.5vw,50px);line-height:1.15;margin:0;max-width:34ch;">PadelCreations builds and installs padel courts for clients across Europe and beyond. Its website had earned strong rankings, but heavy code and bloated assets steadily undermined its performance, and the rankings fell. DsignPoint rebuilt it as a fast, healthy platform with maximum SEO optimisation, and gave every tool an AI layer that helps investors plan their court project with up to 99% accuracy.</p></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="position:relative;background:radial-gradient(ellipse 80% 70% at 50% 0%, oklch(90% 0.04 75), oklch(93% 0.015 60));padding:clamp(32px,6vw,80px) clamp(16px,5vw,64px) clamp(28px,5vw,56px);"><div class="mk-imac"><div class="body"><div class="screen"><div class="scroller" style="--d:48s;"><img loading="lazy" decoding="async" src="../../uploads/cs/pcn_full.jpg" alt="Full-page screenshot of padelcreations.com"></div></div><div class="chin"><i></i></div></div><div class="neck"></div><div class="foot"></div></div><div class="mk-phone"><div class="scr"><img loading="lazy" decoding="async" src="../../uploads/cs/pc_m.jpg" alt="Mobile screenshot of padelcreations.com"></div></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;"><div style="flex:1 1 380px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">padelcreations.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/pco_hero.jpg" alt="Screenshot of padelcreations.com"></div></div><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">The challenge</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">A strong site, held back by its own weight.</h2><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">The website was already generating organic traffic, international leads and business opportunities, and it had been ranking well. Over time, its performance deteriorated. Very heavy code, snippets loading across the entire site even where they were not needed, and high-consumption media assets slowed every page. The rankings eventually dropped as a result. The experience was also complicated: visitors did not know how to navigate the site.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">The task was twofold: restore the technical health that protects visibility, and turn the site into a more sophisticated platform for an international B2B audience.</p><div style="margin-top:28px;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Preserve existing SEO authority</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Improve technical performance</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Organise commercial information more effectively</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Guide visitors through the buying journey</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Improve lead generation</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Support international audiences</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Present products, concepts and completed projects better</p></div></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);"><div style="flex:1 1 300px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">Our approach</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">Health first, then intelligence.</h2></div><div style="flex:2 1 460px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(28px,3.6vw,50px);line-height:1.05;color:oklch(33% 0.14 17);margin:0 0 28px;">Evolution, not revolution.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">We began with the foundations. The code was cleaned and lightened, snippets now load only on the pages that need them, and media assets were optimised, so every page is fast on desktop and on mobile.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">On that healthy base we designed a new information architecture around one principle: no commercial content more than two clicks from the homepage. The site follows the way an international B2B customer buys, and the Enquire Us call to action appears consistently across key pages and decision points.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Then we added intelligence. Every tool on the site now has an AI layer, so visitors get a better and more accurate experience.</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2.4vw,32px);line-height:1.25;margin:32px 0 20px;max-width:40ch;">Discovery → Interaction → Consideration → Conversion → CRM</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Discovery through the homepage and Knowledge Base. Interaction through planning and profitability tools. Consideration through the catalogue, concepts and projects. Conversion through Enquire Us, with Zoho CRM for lead management and follow-up.</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);display:flex;flex-wrap:wrap;gap:clamp(16px,2vw,24px);"><div style="flex:1 1 100%;min-width:0;max-width:880px;margin:0 auto;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">padelcreations.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/pc_kb_half.jpg" alt="Screenshot of padelcreations.com"></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">What we delivered</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">The work, in short.</h2><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);"><div style="flex:1 1 320px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Strategy and architecture</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Information architecture: catalogue, Basic, Pro and Premium lines, product pages, project concepts, planning tools, completed projects, Knowledge Base, enquiry sections</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Customer journey and conversion strategy</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Interactive tools with an AI layer: Floor Planner, 3D Court Planner, Profitability Calculator, Business Plan Guide</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">AI-generated project concepts (hotels, sports clubs, residential developments, rooftops), each with its own indexable page</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Knowledge Base clusters, planned at 10 to 15 pillar articles each, for English and German audiences</p></div><div style="flex:1 1 320px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Build and launch</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">New homepage design and page templates</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Responsive optimisation</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Code, snippet and media optimisation</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Plugin optimisation and migration to Yoast SEO</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Knowledge Base restructuring</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Functional 404 page with search and shortcuts, instead of 301 redirects</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Quality assurance, launch and post-launch stabilisation</p></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;flex-direction:row;"><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">AI-boosted tools</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">Every tool, made smarter.</h2><div style="margin:0 0 28px;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(56px,8vw,112px);line-height:0.95;color:oklch(33% 0.14 17);margin:0 0 8px;">99%</p><p style="font-size:16px;line-height:1.45;margin:0;max-width:34ch;color:oklch(28% 0.01 30);">accuracy on a future padel court project</p></div><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">We added an AI layer to all of the website's tools to give visitors a better experience: the Floor Planner, the 3D Court Planner, the Profitability Calculator and the Business Plan Guide.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Investors planning a padel court project can use them to reach up to 99% accuracy on their future project.</p></div><div style="flex:1.4 1 480px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">padelcreations.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/pc_quote.jpg" alt="Screenshot of padelcreations.com"></div></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;flex-direction:row-reverse;"><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">Maximum SEO optimisation</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">Built to be found.</h2><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">SEO was taken to its maximum across the whole site. The authority the company had built was protected, every page was cleaned of unnecessary weight, and the structure was made fully crawlable and indexable.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">The result is a website with excellent performance on both desktop and mobile, and a homepage that responds in 509 ms, against about four seconds before.</p></div><div style="flex:1 1 420px;min-width:0;"><div style="position:relative;overflow:hidden;color:oklch(97% 0.012 70);background:radial-gradient(ellipse 70% 90% at 15% 0%, oklch(38% 0.15 17 / 0.9) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 100%, oklch(13% 0.07 15 / 0.95) 0%, transparent 65%), oklch(24% 0.11 15);display:flex;align-items:center;min-height:420px;"><img loading="lazy" decoding="async" src="../../uploads/DP-icon-yvoir-cropped.png" alt="" aria-hidden="true" style="position:absolute;right:-6%;top:50%;transform:translateY(-50%);height:150%;width:auto;opacity:0.07;pointer-events:none;"><div aria-hidden="true" style="position:absolute;inset:0;background-image:url(data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27220%27%20height%3D%27220%27%3E%3Cfilter%20id%3D%27n%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.85%27%20numOctaves%3D%273%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20values%3D%270%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200.6%200%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23n%29%27%2F%3E%3C%2Fsvg%3E);opacity:0.09;mix-blend-mode:soft-light;pointer-events:none;"></div><div aria-hidden="true" style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 70% at 50% 50%, transparent 40%, oklch(10% 0.06 15 / 0.55) 100%);pointer-events:none;"></div><div style="position:relative;z-index:2;padding:clamp(32px,5vw,64px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 20px;">Homepage server response</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(64px,9vw,128px);line-height:0.95;margin:0 0 20px;color:oklch(83% 0.05 80);">509 ms</p><p style="font-size:clamp(16px,1.4vw,19px);line-height:1.5;margin:0;max-width:30ch;color:oklch(95% 0.012 60);">against about four seconds before the rebuild</p></div></div></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;flex-direction:row;"><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">A clear sales funnel</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">Everyone finds their way.</h2><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Before, visitors did not know how to navigate the website, and the experience was complicated. We introduced a clear sales funnel and, with it, the project concepts: starting points organised around the end result a visitor wants to reach.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">For new investors, this makes it easier to understand how a padel court is built and where to begin. For returning investors, it offers a direct route to the catalogue they are looking for.</p></div><div style="flex:1.7 1 560px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">padelcreations.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/pcn_funnel.jpg" alt="Screenshot of padelcreations.com"></div></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;flex-direction:row-reverse;"><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">A functional 404</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">A 404 that helps.</h2><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Many of the old URLs no longer had a matching page, or any related content. Redirecting them with 301s would have sent visitors and search engines to pages that do not match what they were looking for, which hurts SEO.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">So we built a functional 404 instead. It helps visitors find their way with a Knowledge Base search, topic shortcuts and direct routes to the main sections, so every dead link still leads to something useful.</p></div><div style="flex:1.5 1 520px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">padelcreations.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/pc_404.jpg" alt="Screenshot of padelcreations.com"></div></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Technology</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(28px,4vw,58px);line-height:1.15;margin:0;">WordPress <span aria-hidden="true" style="color:oklch(52% 0.09 70);">/</span> Elementor Pro <span aria-hidden="true" style="color:oklch(52% 0.09 70);">/</span> Yoast SEO <span aria-hidden="true" style="color:oklch(52% 0.09 70);">/</span> Zoho CRM <span aria-hidden="true" style="color:oklch(52% 0.09 70);">/</span> AI-generated concept imagery</p></div></section><div style="position:relative;overflow:hidden;color:oklch(97% 0.012 70);background:radial-gradient(ellipse 70% 90% at 15% 0%, oklch(38% 0.15 17 / 0.9) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 100%, oklch(13% 0.07 15 / 0.95) 0%, transparent 65%), oklch(24% 0.11 15);padding:clamp(72px,12vh,140px) 0;"><img loading="lazy" decoding="async" src="../../uploads/DP-icon-yvoir-cropped.png" alt="" aria-hidden="true" style="position:absolute;right:-6%;top:50%;transform:translateY(-50%);height:150%;width:auto;opacity:0.07;pointer-events:none;"><div aria-hidden="true" style="position:absolute;inset:0;background-image:url(data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27220%27%20height%3D%27220%27%3E%3Cfilter%20id%3D%27n%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.85%27%20numOctaves%3D%273%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20values%3D%270%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200.6%200%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23n%29%27%2F%3E%3C%2Fsvg%3E);opacity:0.09;mix-blend-mode:soft-light;pointer-events:none;"></div><div aria-hidden="true" style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 70% at 50% 50%, transparent 40%, oklch(10% 0.06 15 / 0.55) 100%);pointer-events:none;"></div><div style="position:relative;max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 clamp(32px,5vh,56px);">Results</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:clamp(32px,5vw,72px);"><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(30px,3.6vw,52px);line-height:1;margin:0 0 14px;color:oklch(83% 0.05 80);">99%</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:28ch;color:oklch(93% 0.015 50);">accuracy investors can reach on their future court project with the AI-boosted tools</p></div><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(30px,3.6vw,52px);line-height:1;margin:0 0 14px;color:oklch(83% 0.05 80);">190/190</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:28ch;color:oklch(93% 0.015 50);">URLs returned a clean 200 status, were indexable and carried self-referencing canonical tags</p></div><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(30px,3.6vw,52px);line-height:1;margin:0 0 14px;color:oklch(83% 0.05 80);">509 ms</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:28ch;color:oklch(93% 0.015 50);">homepage server response time, against about four seconds before the rebuild</p></div><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(30px,3.6vw,52px);line-height:1;margin:0 0 14px;color:oklch(83% 0.05 80);">EN + DE</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:28ch;color:oklch(93% 0.015 50);">hreflang implemented across the English and German versions</p></div></div><p style="font-size:clamp(18px,1.7vw,22px);line-height:1.6;margin:clamp(40px,6vh,64px) 0 0;color:oklch(92% 0.015 60);max-width:62ch;">The website moved from a heavy, declining site to a perfectly healthy platform with excellent performance on desktop and mobile. With maximum SEO optimisation and AI in every tool, it now supports the full buying journey of an international investor, from the first visit to the enquiry.</p></div></div><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Business value</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,3.5vw,50px);line-height:1.15;margin:0 0 clamp(48px,8vh,88px);max-width:34ch;">A fast, healthy and findable website that protects the visibility the company had earned and turns it into a platform where an international investor can plan a padel court project with confidence.</p><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Key takeaways</p><div style="display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,64px);"><div style="flex:1 1 260px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(32px,3.4vw,48px);line-height:1;color:oklch(52% 0.09 70);margin:0 0 14px;">01</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,26px);line-height:1.25;margin:0;max-width:26ch;">Performance is part of SEO. Heavy code and unused snippets can cost the rankings a business has earned.</p></div><div style="flex:1 1 260px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(32px,3.4vw,48px);line-height:1;color:oklch(52% 0.09 70);margin:0 0 14px;">02</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,26px);line-height:1.25;margin:0;max-width:26ch;">Load only what each page needs. Speed on desktop and mobile is built in, not added later.</p></div><div style="flex:1 1 260px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(32px,3.4vw,48px);line-height:1;color:oklch(52% 0.09 70);margin:0 0 14px;">03</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,26px);line-height:1.25;margin:0;max-width:26ch;">AI works best inside the tools people already use, where it makes a good experience more accurate.</p></div></div></div></section><div style="position:relative;overflow:hidden;color:oklch(97% 0.012 70);background:radial-gradient(ellipse 70% 90% at 15% 0%, oklch(38% 0.15 17 / 0.9) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 100%, oklch(13% 0.07 15 / 0.95) 0%, transparent 65%), oklch(24% 0.11 15);padding:clamp(72px,12vh,140px) 0;"><img loading="lazy" decoding="async" src="../../uploads/DP-icon-yvoir-cropped.png" alt="" aria-hidden="true" style="position:absolute;right:-6%;top:50%;transform:translateY(-50%);height:150%;width:auto;opacity:0.07;pointer-events:none;"><div aria-hidden="true" style="position:absolute;inset:0;background-image:url(data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27220%27%20height%3D%27220%27%3E%3Cfilter%20id%3D%27n%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.85%2