---
import Layout from '../../../layouts/Layout.astro';

const ld = [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dsignpoint.com/"}, {"@type": "ListItem", "position": 2, "name": "Case studies", "item": "https://dsignpoint.com/case-studies/"}, {"@type": "ListItem", "position": 3, "name": "JD Assist", "item": "https://dsignpoint.com/case-studies/jd-assist/"}]}];
---
<Layout title="JD Assist case study | DsignPoint" description="How DsignPoint built demand for a new medical call centre academy, from positioning to a website and funnel that turn interest into enrolments." path="/case-studies/jd-assist/" ogImage="/uploads/cs/jd_hero.jpg"   jsonld={ld}>


<div style="position:relative;overflow-x:hidden;">
<section style="position:relative;min-height:min(94vh,880px);display:flex;flex-direction:column;color:oklch(97% 0.012 70);overflow:hidden;"><img src="../../uploads/section6-jd-assist-bg.webp" alt="A trainer presenting real call scenarios to a training team, part of the JD Assist project" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"><div style="position:absolute;inset:0;background:linear-gradient(180deg, oklch(15% 0.05 20 / 0.78) 0%, oklch(15% 0.05 20 / 0.55) 40%, oklch(12% 0.06 18 / 0.95) 100%);"></div>    <div style="position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(20px,5vw,56px);width:100%;max-width:1200px;margin:0 auto;">
      <a href="../.." class="dp-logo" aria-label="DsignPoint home"><span style="display:flex;align-items:center;gap:12px;"><img src="../../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:48px;width:auto;display:block;"><img src="../../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:24px;width:auto;display:block;"></span></a>
      <button type="button" class="dp-burger" aria-label="Open menu" aria-expanded="false" aria-controls="dp-nav"><span></span><span></span></button><div id="dp-nav" role="navigation" aria-label="Main" class="dp-nav-links" style="display:flex;align-items:center;gap:clamp(14px,2vw,30px);font-size:13px;letter-spacing:0.06em;text-transform:uppercase;">
        <a href="../.." style="color:oklch(88% 0.015 60);">Home</a>
        <a href="../../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
        <a href=".." style="color:oklch(88% 0.015 60);">Case Studies</a>
        <a href="../../insights/" style="color:oklch(88% 0.015 60);">Insights</a>
        <a href="../../about/" style="color:oklch(88% 0.015 60);">About</a>
        <a href="../../book-a-call/" style="display:inline-flex;align-items:center;gap:10px;border:1px solid oklch(83% 0.05 80);background:oklch(83% 0.05 80);color:oklch(24% 0.11 15);padding:12px 24px;font-weight:600;box-shadow:0 8px 28px oklch(83% 0.05 80 / 0.35);transition:background 0.35s ease, border-color 0.35s ease, gap 0.35s ease;" class="h1">Book a call <span aria-hidden="true">→</span></a>
      </div>
    </div>

<div style="position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%;max-width:1200px;margin:0 auto;padding:clamp(48px,8vh,96px) clamp(20px,5vw,56px) clamp(32px,5vh,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 20px;">Case study · Training academy &amp; lead generation</p><h1 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,5.3vw,72px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(36px,6vh,64px);max-width:20ch;">Building demand for a new medical call centre academy.</h1><div style="margin:0 0 clamp(36px,6vh,64px);"><a target="_blank" rel="noopener" href="http://jd-assist.com/" style="display:inline-flex;align-items:center;gap:12px;background:oklch(97% 0.012 70);color:oklch(33% 0.14 17);padding:17px 36px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;font-weight:500;transition:background 0.35s ease, gap 0.35s ease;" class="h2">Visit the live website <span aria-hidden="true">→</span></a></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px clamp(20px,3vw,40px);"><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Client</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">JD Assist, France</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Industry</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Medical telephone assistance &amp; professional training</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Services</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Launch preparation · Landing-page strategy · Meta Ads · Conversion tracking</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Platforms</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Website · Meta Ads · Meta Pixel</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Overview</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,3.5vw,50px);line-height:1.15;margin:0;max-width:34ch;">JD Assist is a French medical telephone assistance business that opened a professional academy for people who want a career as medical call centre agents. DsignPoint prepared its digital launch and built the first acquisition funnel to reach and capture its future students.</p></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="position:relative;background:radial-gradient(ellipse 80% 70% at 50% 0%, oklch(90% 0.04 75), oklch(93% 0.015 60));padding:clamp(32px,6vw,80px) clamp(16px,5vw,64px) clamp(28px,5vw,56px);"><div class="mk-imac"><div class="body"><div class="screen"><div class="scroller" style="--d:50s;"><img loading="lazy" decoding="async" src="../../uploads/cs/jd_full.jpg" alt="Full-page screenshot of jd-assist.com"></div></div><div class="chin"><i></i></div></div><div class="neck"></div><div class="foot"></div></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;"><div style="flex:1 1 380px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">jd-assist.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/jd_jessica.jpg" alt="Screenshot of jd-assist.com"></div></div><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">The challenge</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">A new academy, no audience yet.</h2><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">A new academy starts without an audience. JD Assist needed to generate interest, build a pool of potential students and give visitors a clear way to raise their hand.</p><div style="margin-top:28px;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Generate interest in the academy</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Build an audience of potential students</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Collect waiting-list registrations</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Encourage downloads of a guide</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Create an acquisition funnel through the website</p></div></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);"><div style="flex:1 1 300px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">Our approach</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">One funnel, two actions.</h2></div><div style="flex:2 1 460px;min-width:0;"><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">We built the funnel around two simple actions, each designed to capture a prospect's details: join the waiting list, or download the guide. The landing-page strategy was designed around them.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Paid acquisition on Meta Ads brought the right audience to that page: a focused campaign in France aimed at women aged 25 to 55 with interests in medical secretarial work, professional training, career changes and remote work.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Meta Pixel was installed and the conversion events were tested. The WaitingList event was confirmed in Meta Test Events, so registrations can be measured.</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);display:flex;flex-wrap:wrap;gap:clamp(16px,2vw,24px);"><div style="flex:2 1 460px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">jd-assist.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/jd_comp.jpg" alt="Screenshot of jd-assist.com"></div></div><div style="flex:1 1 240px;min-width:0;display:flex;flex-direction:column;gap:clamp(16px,2vw,24px);"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">jd-assist.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/jd_navy.jpg" alt="Screenshot of jd-assist.com"></div><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">jd-assist.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/jd_invest.jpg" alt="Screenshot of jd-assist.com"></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">What we delivered</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">The work, in short.</h2><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);"><div style="flex:1 1 320px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Strategy</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Landing-page acquisition strategy</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Waiting list and guide-download funnel</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Audience definition and targeting</p></div><div style="flex:1 1 320px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Execution</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Website and digital launch preparation</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Meta Ads campaign</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Meta Pixel and conversion-event setup and testing</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Technology</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(28px,4vw,58px);line-height:1.15;margin:0;">Meta Ads <span aria-hidden="true" style="color:oklch(52% 0.09 70);">/</span> Meta Pixel and Meta Test Events <span aria-hidden="true" style="color:oklch(52% 0.09 70);">/</span> Website landing page</p></div></section><div style="position:relative;overflow:hidden;color:oklch(97% 0.012 70);background:radial-gradient(ellipse 70% 90% at 15% 0%, oklch(38% 0.15 17 / 0.9) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 100%, oklch(13% 0.07 15 / 0.95) 0%, transparent 65%), oklch(24% 0.11 15);padding:clamp(72px,12vh,140px) 0;"><img loading="lazy" decoding="async" src="../../uploads/DP-icon-yvoir-cropped.png" alt="" aria-hidden="true" style="position:absolute;right:-6%;top:50%;transform:translateY(-50%);height:150%;width:auto;opacity:0.07;pointer-events:none;"><div aria-hidden="true" style="position:absolute;inset:0;background-image:url(data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27220%27%20height%3D%27220%27%3E%3Cfilter%20id%3D%27n%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.85%27%20numOctaves%3D%273%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20values%3D%270%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200.6%200%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23n%29%27%2F%3E%3C%2Fsvg%3E);opacity:0.09;mix-blend-mode:soft-light;pointer-events:none;"></div><div aria-hidden="true" style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 70% at 50% 50%, transparent 40%, oklch(10% 0.06 15 / 0.55) 100%);pointer-events:none;"></div><div style="position:relative;max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 clamp(32px,5vh,56px);">Results</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:clamp(32px,5vw,72px);"><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(40px,5.6vw,80px);line-height:1;margin:0 0 14px;color:oklch(83% 0.05 80);">11</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:28ch;color:oklch(93% 0.015 50);">leads generated in the first two days of the campaign</p></div><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(40px,5.6vw,80px);line-height:1;margin:0 0 14px;color:oklch(83% 0.05 80);">Tracked</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:28ch;color:oklch(93% 0.015 50);">conversions measured from day one, with Meta Pixel installed and the WaitingList event confirmed</p></div></div><p style="font-size:14px;line-height:1.5;margin:clamp(32px,5vh,48px) 0 0;color:oklch(80% 0.02 40);max-width:70ch;">Early result from the first two days of the campaign.</p></div></div><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Business value</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,3.5vw,50px);line-height:1.15;margin:0 0 clamp(48px,8vh,88px);max-width:34ch;">Before the academy opened its doors, JD Assist had a measurable way to reach and capture future students, and an early signal of demand from its target audience.</p><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Key takeaways</p><div style="display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,64px);"><div style="flex:1 1 260px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(32px,3.4vw,48px);line-height:1;color:oklch(52% 0.09 70);margin:0 0 14px;">01</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,26px);line-height:1.25;margin:0;max-width:26ch;">Start with the action you want a prospect to take, then build the page and the campaign around it.</p></div><div style="flex:1 1 260px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(32px,3.4vw,48px);line-height:1;color:oklch(52% 0.09 70);margin:0 0 14px;">02</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,26px);line-height:1.25;margin:0;max-width:26ch;">Track from day one. A campaign is only as useful as the conversions you can see.</p></div><div style="flex:1 1 260px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(32px,3.4vw,48px);line-height:1;color:oklch(52% 0.09 70);margin:0 0 14px;">03</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,26px);line-height:1.25;margin:0;max-width:26ch;">A focused campaign can test real demand before you scale.</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">jd-assist.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/jd_parcours.jpg" alt="Screenshot of jd-assist.com"></div></div></section><div style="position:relative;overflow:hidden;color:oklch(97% 0.012 70);background:radial-gradient(ellipse 70% 90% at 15% 0%, oklch(38% 0.15 17 / 0.9) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 100%, oklch(13% 0.07 15 / 0.95) 0%, transparent 65%), oklch(24% 0.11 15);padding:clamp(72px,12vh,