---
import Layout from '../../layouts/Layout.astro';

const ld = [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dsignpoint.com/"}, {"@type": "ListItem", "position": 2, "name": "Case studies", "item": "https://dsignpoint.com/case-studies/"}]}];
---
<Layout title="Case studies | DsignPoint" description="See how DsignPoint helped businesses outgrow what worked: JD Assist, La Casita Bilingual School and PadelCreations." path="/case-studies/"    jsonld={ld}>


<div style="position:relative;overflow-x:hidden;">
<section style="position:relative;min-height:min(72vh,700px);display:flex;flex-direction:column;color:oklch(97% 0.012 70);overflow:hidden;background:oklch(18% 0.04 20);"><img src="../uploads/bn_cases.webp" alt="Designer working at a sunlit desk with palm trees and the sea outside the window" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;"><div style="position:absolute;inset:0;background:linear-gradient(180deg, oklch(15% 0.05 20 / 0.40) 0%, oklch(15% 0.05 20 / 0.18) 40%, oklch(12% 0.06 18 / 0.92) 100%);"></div>
    <div style="position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(20px,5vw,56px);width:100%;max-width:1200px;margin:0 auto;">
      <a href=".." class="dp-logo" aria-label="DsignPoint home"><span style="display:flex;align-items:center;gap:12px;"><img src="../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:48px;width:auto;display:block;"><img src="../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:24px;width:auto;display:block;"></span></a>
      <button type="button" class="dp-burger" aria-label="Open menu" aria-expanded="false" aria-controls="dp-nav"><span></span><span></span></button><div id="dp-nav" role="navigation" aria-label="Main" class="dp-nav-links" style="display:flex;align-items:center;gap:clamp(14px,2vw,30px);font-size:13px;letter-spacing:0.06em;text-transform:uppercase;">
        <a href=".." style="color:oklch(88% 0.015 60);">Home</a>
        <a href="../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
        <a href="./" style="color:oklch(97% 0.012 70);">Case Studies</a>
        <a href="../insights/" style="color:oklch(88% 0.015 60);">Insights</a>
        <a href="../about/" style="color:oklch(88% 0.015 60);">About</a>
        <a href="../book-a-call/" style="display:inline-flex;align-items:center;gap:10px;border:1px solid oklch(83% 0.05 80);background:oklch(83% 0.05 80);color:oklch(24% 0.11 15);padding:12px 24px;font-weight:600;box-shadow:0 8px 28px oklch(83% 0.05 80 / 0.35);transition:background 0.35s ease, border-color 0.35s ease, gap 0.35s ease;" class="h1">Book a call <span aria-hidden="true">→</span></a>
      </div>
    </div>


<div style="position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(72px,12vh,140px) clamp(20px,5vw,56px) clamp(32px,5vh,64px);width:100%;max-width:1200px;margin:0 auto;"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-size:12px;color:oklch(83% 0.05 80);margin:0 0 24px;">Case studies</p><h1 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(34px,4.8vw,68px);line-height:1.0;letter-spacing:-0.01em;margin:0 0 24px;max-width:20ch;">Where businesses outgrew what worked.</h1><p style="font-size:clamp(15px,1.4vw,18px);line-height:1.55;margin:0 0 28px;max-width:52ch;color:oklch(88% 0.015 60);">Recent projects, each one starting with a question about the business, not a request for a service.</p></div>
</section>
<section style="background:oklch(97% 0.012 70);padding:clamp(48px,8vh,96px) 0 clamp(64px,10vh,120px);"><div style="width:100%;max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);display:flex;flex-wrap:wrap;gap:clamp(16px,2vw,28px);align-items:flex-start;">
<div class="mcol"><a class="tile" href="padelcreations/" style="aspect-ratio:4/5;"><img loading="lazy" decoding="async" src="../uploads/cs/pc_thumb.webp" alt="A padel court at sunset with glass walls, palm trees and mountains"><div style="position:absolute;inset:0;background:linear-gradient(180deg, transparent 10%, oklch(12% 0.06 18 / 0.6) 45%, oklch(12% 0.06 18 / 0.94) 100%);"></div><div style="position:absolute;left:0;right:0;bottom:0;padding:clamp(20px,2.4vw,32px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 12px;">PadelCreations · Padel court construction</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,2.6vw,38px);line-height:1.05;letter-spacing:-0.01em;margin:0 0 12px;">From a heavy, declining website to a fast, AI-boosted platform.</p><p style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin:0;color:oklch(92% 0.015 50);display:flex;justify-content:space-between;align-items:center;gap:16px;"><span>Web design · SEO · AI tools</span><span class="more">Read the story <span class="arrow" aria-hidden="true">→</span></span></p></div></a><a class="tile" href="padelcreations/" style="background:oklch(33% 0.14 17);color:oklch(97% 0.012 70);padding:clamp(28px,3.4vw,48px);display:flex;flex-direction:column;justify-content:space-between;gap:clamp(40px,6vw,80px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0;">PadelCreations</p><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(52px,6.4vw,92px);line-height:0.95;letter-spacing:-0.02em;margin:0 0 16px;">Up to 99%</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:30ch;">accuracy for investors planning a padel court with the AI-boosted tools.</p></div><p style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin:0;">Read the story <span class="arrow" aria-hidden="true">→</span></p></a></div>
<div class="mcol" style="margin-top:clamp(0px,7vw,96px);"><div style="background:oklch(93% 0.015 60);padding:clamp(28px,3.4vw,48px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(52% 0.09 70);margin:0 0 20px;">How we work</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(30px,3.4vw,48px);line-height:1.05;color:oklch(33% 0.14 17);margin:0 0 24px;">We diagnose before we prescribe.</p><p style="font-size:16px;line-height:1.6;margin:0 0 24px;max-width:36ch;">Every project starts with the business, not the brief. The scope follows the diagnosis.</p><a href="../approach/" style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;">Our approach →</a></div><a class="tile" href="la-casita/" style="aspect-ratio:1/1;"><img loading="lazy" decoding="async" src="../uploads/cs/lc_thumb.webp" alt="La Casita school building with a sunflower mural and a red paved path in golden light"><div style="position:absolute;inset:0;background:linear-gradient(180deg, transparent 10%, oklch(12% 0.06 18 / 0.6) 45%, oklch(12% 0.06 18 / 0.94) 100%);"></div><div style="position:absolute;left:0;right:0;bottom:0;padding:clamp(20px,2.4vw,32px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 12px;">La Casita · Bilingual school</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,2.6vw,38px);line-height:1.05;letter-spacing:-0.01em;margin:0 0 12px;">A disorganised website became a clear path to enrolment.</p><p style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin:0;color:oklch(92% 0.015 50);display:flex;justify-content:space-between;align-items:center;gap:16px;"><span>Website · Funnel · SEO</span><span class="more">Read the story <span class="arrow" aria-hidden="true">→</span></span></p></div></a><div style="background:oklch(24% 0.11 15);color:oklch(97% 0.012 70);padding:clamp(28px,3.4vw,48px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 20px;">Next</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(28px,3vw,42px);line-height:1.08;margin:0 0 24px;">Is your business at a turning point?</p><a class="lnk" href="../book-a-call/" style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(83% 0.05 80);border-bottom:1px solid oklch(83% 0.05 80);padding-bottom:4px;">Let's talk about it</a></div></div>
<div class="mcol"><a class="tile" href="jd-assist/" style="aspect-ratio:4/5;"><img loading="lazy" decoding="async" src="../uploads/section6-jd-assist-bg.webp" alt="A trainer presenting real call scenarios to a training team, part of the JD Assist rebrand"><div style="position:absolute;inset:0;background:linear-gradient(180deg, transparent 10%, oklch(12% 0.06 18 / 0.6) 45%, oklch(12% 0.06 18 / 0.94) 100%);"></div><div style="position:absolute;left:0;right:0;bottom:0;padding:clamp(20px,2.4vw,32px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 12px;">JD Assist · Training</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,2.6vw,38px);line-height:1.05;letter-spacing:-0.01em;margin:0 0 12px;">From established service business to a new training direction.</p><p style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin:0;color:oklch(92% 0.015 50);display:flex;justify-content:space-between;align-items:center;gap:16px;"><span>Brand · Landing page · Campaign</span><span class="more">Read the story <span class="arrow" aria-hidden="true">→</span></span></p></div></a><a class="tile" href="la-casita/" style="background:oklch(83% 0.05 80);color:oklch(24% 0.11 15);padding:clamp(28px,3.4vw,48px);display:flex;flex-direction:column;justify-content:space-between;gap:clamp(40px,6vw,80px);"><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;">La Casita</p><div><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(52px,6.4vw,92px);line-height:0.95;letter-spacing:-0.02em;margin:0 0 16px;">Fewer clicks</p><p style="font-size:16px;line-height:1.5;margin:0;max-width:30ch;">to the information parents look for, in a site they come back to.</p></div><p style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin:0;">Read the story <span class="arrow" aria-hidden="true">→</span></p></a></div>
</div></section>
  <section style="position:relative;min-height:70vh;display:flex;align-items:center;justify-content:center;color:oklch(97% 0.012 70);text-align:center;overflow:hidden;">
    <img loading="lazy" decoding="async" src="../uploads/CTA-section-bg.webp" alt="Colleagues reviewing work together at a café table, backlit by evening light" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 40%, oklch(30% 0.13 17 / 0.4), oklch(12% 0.07 18 / 0.88));"></div>
    <div style="position:relative;max-width:820px;padding:0 clamp(20px,5vw,56px);">
      <h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(36px,6vw,80px);margin:0 0 28px;">Maybe it's time to find out.</h2>
      <p style="font-size:clamp(16px,1.6vw,19px);line-height:1.6;margin:0 auto 40px;max-width:46ch;color:oklch(90% 0.015 40);">Tell us where your business is today, where you want to take it, and what's not quite fitting anymore.</p>
      <a href="../book-a-call/" style="display:inline-flex;align-items:center;gap:12px;background:oklch(97% 0.012 70);color:oklch(33% 0.14 17);padding:17px 36px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;font-weight:500;transition:background 0.35s ease, gap 0.35s ease;" class="h2">Let's talk <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <footer style="background:oklch(15% 0.01 30);color:oklch(88% 0.015 60);padding:clamp(48px,8vh,80px) clamp(20px,5vw,56px) 32px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="dp-fgrid" style="display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:clamp(24px,4vw,40px);padding-bottom:48px;border-bottom:1px solid oklch(30% 0.02 30);">
        <div>
          <a href=".."><span style="display:flex;align-items:center;gap:11px;margin-bottom:18px;"><img loading="lazy" decoding="async" src="../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:42px;width:auto;display:block;"><img loading="lazy" decoding="async" src="../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:21px;width:auto;display:block;"></span></a>
          <p style="font-size:14px;line-height:1.6;margin:0;color:oklch(70% 0.015 55);max-width:28ch;">A strategic business, brand and digital partner for founders whose business has outgrown its brand.</p>
        </div>
        <div>
          <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(55% 0.015 50);margin:0 0 16px;">Site</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;">
            <a href=".." style="color:oklch(88% 0.015 60);">Home</a> <a href="../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
            <a href="./" style="color:oklch(88% 0.015 60);">Case Studies</a>
            <a href="../insights/" style="color:oklch(88% 0.015 60);">Insights</a>
            <a href="../about/" style="color:oklch(88% 0.015 60);">About</a>
          </div>
        </div>
        <div>
          <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(55% 0.015 50);margin:0 0 16px;">Contact</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;">
            <a href="tel:+34644844692" style="color:oklch(88% 0.015 60);">+34 644 84 46 92</a>
            <a href="mailto:info@dsignpoint.com" style="color:oklch(88% 0.015 60);">info@dsignpoint.com</a>
            <span style="color:oklch(70% 0.015 55);">Torrevieja, Spain</span>
            <span style="color:oklch(55% 0.015 50);font-size:13px;">FR · EN · ES · PT</span>
          </div>
        </div>
        <div>
          <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(55% 0.015 50);margin:0 0 16px;">Follow</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;">
            <a href="https://www.instagram.com/dsignpoint" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">Instagram</a>
            <a href="https://www.facebook.com/dsignpoint" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">Facebook</a>
            <a href="https://www.linkedin.com/company/dsignpoint/" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://www.youtube.com/@cindymateus" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">YouTube</a>
          </div>
        </div>
      </div>
      <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:24px;font-size:12px;color:oklch(50% 0.015 45);">
        <span>DSIGNPOINT © 2026 ALL RIGHTS RESERVED</span>
        <div style="display:flex;gap:20px;">
          <a href="../privacy-policy/" style="color:oklch(50% 0.015 45);">Privacy Policy</a>
          <a href="../terms-and-conditions/" style="color:oklch(50% 0.015 45);">Terms &amp; Conditions</a>
          <a href="#" data-cc-open style="color:oklch(50% 0.015 45);">Cookie settings</a>
        </div>
      </div>
    </div>
  </footer>
</div>


<style is:global>
  .tile{position:relative;display:block;overflow:hidden;color:oklch(97% 0.012 70);}
  .tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1);}
  .tile:hover img{transform:scale(1.05);}
  .tile:hover{color:oklch(97% 0.012 70);}
  .lnk:hover{color:oklch(97% 0.012 70) !important;border-color:oklch(97% 0.012 70) !important;}
  .tile .arrow{display:inline-block;transition:transform .4s ease;}
  .tile:hover .arrow{transform:translateX(8px);}
  .tile .more{opacity:0;transform:translateY(8px);transition:opacity .5s ease, transform .5s ease;}
  .tile:hover .more{opacity:1;transform:none;}
  @media (hover:none){.tile .more{opacity:1;transform:none;}}
  .mcol{flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:clamp(16px,2vw,28px);}
.h1:hover{background:oklch(97% 0.012 70) !important;border-color:oklch(97% 0.012 70) !important;color:oklch(33% 0.14 17) !important;gap:16px !important}.h2:hover{background:oklch(83% 0.05 80) !important;gap:18px !important}</style>
</Layout>
