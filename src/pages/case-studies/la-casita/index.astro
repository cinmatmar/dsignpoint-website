---
import Layout from '../../../layouts/Layout.astro';

const ld = [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dsignpoint.com/"}, {"@type": "ListItem", "position": 2, "name": "Case studies", "item": "https://dsignpoint.com/case-studies/"}, {"@type": "ListItem", "position": 3, "name": "La Casita", "item": "https://dsignpoint.com/case-studies/la-casita/"}]}];
---
<Layout title="La Casita Bilingual School case study | DsignPoint" description="How DsignPoint turned a disorganised school website into a clear path to enrolment, and a place parents come back to." path="/case-studies/la-casita/" ogImage="/uploads/cs/lc_hero_bg.jpg"   jsonld={ld}>


<div style="position:relative;overflow-x:hidden;">
<section style="position:relative;min-height:min(94vh,880px);display:flex;flex-direction:column;color:oklch(97% 0.012 70);overflow:hidden;"><img src="../../uploads/cs/lc_hero_bg.jpg" alt="La Casita school building with a sunflower mural and a red paved path in golden light" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"><div style="position:absolute;inset:0;background:linear-gradient(180deg, oklch(15% 0.05 20 / 0.78) 0%, oklch(15% 0.05 20 / 0.55) 40%, oklch(12% 0.06 18 / 0.95) 100%);"></div>    <div style="position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(20px,5vw,56px);width:100%;max-width:1200px;margin:0 auto;">
      <a href="../.." class="dp-logo" aria-label="DsignPoint home"><span style="display:flex;align-items:center;gap:12px;"><img src="../../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:48px;width:auto;display:block;"><img src="../../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:24px;width:auto;display:block;"></span></a>
      <button type="button" class="dp-burger" aria-label="Open menu" aria-expanded="false" aria-controls="dp-nav"><span></span><span></span></button><div id="dp-nav" role="navigation" aria-label="Main" class="dp-nav-links" style="display:flex;align-items:center;gap:clamp(14px,2vw,30px);font-size:13px;letter-spacing:0.06em;text-transform:uppercase;">
        <a href="../.." style="color:oklch(88% 0.015 60);">Home</a>
        <a href="../../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
        <a href=".." style="color:oklch(88% 0.015 60);">Case Studies</a>
        <a href="../../insights/" style="color:oklch(88% 0.015 60);">Insights</a>
        <a href="../../about/" style="color:oklch(88% 0.015 60);">About</a>
        <a href="../../book-a-call/" style="display:inline-flex;align-items:center;gap:10px;border:1px solid oklch(83% 0.05 80);background:oklch(83% 0.05 80);color:oklch(24% 0.11 15);padding:12px 24px;font-weight:600;box-shadow:0 8px 28px oklch(83% 0.05 80 / 0.35);transition:background 0.35s ease, border-color 0.35s ease, gap 0.35s ease;" class="h1">Book a call <span aria-hidden="true">→</span></a>
      </div>
    </div>

<div style="position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%;max-width:1200px;margin:0 auto;padding:clamp(48px,8vh,96px) clamp(20px,5vw,56px) clamp(32px,5vh,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 20px;">Case study · Website, sales funnel &amp; SEO</p><h1 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,5.3vw,72px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(36px,6vh,64px);max-width:20ch;">Turning a disorganised website into a clear path to enrolment, and a place parents come back to.</h1><div style="margin:0 0 clamp(36px,6vh,64px);"><a target="_blank" rel="noopener" href="https://lacasitabilingual.com" style="display:inline-flex;align-items:center;gap:12px;background:oklch(97% 0.012 70);color:oklch(33% 0.14 17);padding:17px 36px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;font-weight:500;transition:background 0.35s ease, gap 0.35s ease;" class="h2">Visit the live website <span aria-hidden="true">→</span></a></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px clamp(20px,3vw,40px);"><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Client</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">La Casita Bilingual School</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Industry</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Education</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Location</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Torrevieja area, Spain</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Services</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">Website redesign · Sales funnel · Blog · SEO</p></div><div><p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 8px;">Platforms</p><p style="font-size:15px;line-height:1.4;margin:0;color:oklch(95% 0.012 60);">WordPress · Yoast SEO Pro</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:28px;">Overview</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(26px,3.5vw,50px);line-height:1.15;margin:0;max-width:34ch;">La Casita Bilingual School is a well-established early-years school in the Torrevieja area, with a full waitlist and a strong local reputation. Its website, however, did not reflect the quality of the school or support the way families use it. DsignPoint restructured the site around the visitor, shortened the path to essential information and introduced a guided journey that leads prospective parents towards the decision to enrol.</p></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="position:relative;background:radial-gradient(ellipse 80% 70% at 50% 0%, oklch(90% 0.04 75), oklch(93% 0.015 60));padding:clamp(32px,6vw,80px) clamp(16px,5vw,64px) clamp(28px,5vw,56px);"><div class="mk-imac"><div class="body"><div class="screen"><div class="scroller" style="--d:34s;"><img loading="lazy" decoding="async" src="../../uploads/cs/lcn_full.jpg" alt="Full-page screenshot of lacasitabilingual.com"></div></div><div class="chin"><i></i></div></div><div class="neck"></div><div class="foot"></div></div><div class="mk-phone"><div class="scr"><img loading="lazy" decoding="async" src="../../uploads/cs/lc_m.jpg" alt="Mobile screenshot of lacasitabilingual.com"></div></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:center;"><div style="flex:1 1 380px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">lacasitabilingual.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/lco_top.jpg" alt="Screenshot of lacasitabilingual.com"></div></div><div style="flex:1 1 420px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">The challenge</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">No client problem. A website problem.</h2><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">La Casita does not have a client-acquisition problem. The school ranks well on Google, faces limited local competition and has a waitlist that extends two years ahead.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">The opportunity lay in the website itself. Information was scattered, key content required too many clicks to reach, and there was no clear route from a first visit to enrolment. At the same time, parents use the site regularly, which meant it needed to serve current families as well as prospective ones, and give both a reason to return.</p><div style="margin-top:28px;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Organise all the information</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Reduce the clicks to the main content</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Guide visitors towards the decision to enrol</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Give parents reasons to come back</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);margin-bottom:10px;"><span aria-hidden="true" style="color:oklch(52% 0.09 70);">— </span>Give the blog a real role</p></div></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);"><div style="flex:1 1 300px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">Our approach</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">Organise, guide, bring them back.</h2></div><div style="flex:2 1 460px;min-width:0;"><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">We began with the visitor rather than the pages. The full content was reorganised into a clear structure, so that essential information sits within a few clicks.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">On that foundation we built a sales funnel. Each page advances the visitor by one step, from who the school is, to how it teaches, to what a day there feels like, until enrolment becomes the natural next step.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">To encourage repeat visits, the blog was revalued as a core part of the experience, supported by "Un día en La Casita", an interactive timeline of the school day. An SEO layer completes the work, making each page easier to find and more pleasant for parents to read.</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:0 0 clamp(72px,12vh,140px);"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);display:flex;flex-wrap:wrap;gap:clamp(16px,2vw,24px);"><div style="flex:2 1 460px;min-width:0;"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">lacasitabilingual.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/lcn_valores.jpg" alt="Screenshot of lacasitabilingual.com"></div></div><div style="flex:1 1 240px;min-width:0;display:flex;flex-direction:column;gap:clamp(16px,2vw,24px);"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">lacasitabilingual.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/lcn_diario.jpg" alt="Screenshot of lacasitabilingual.com"></div><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">lacasitabilingual.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/lcn_fomentamos.jpg" alt="Screenshot of lacasitabilingual.com"></div></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">What we delivered</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">The work, in short.</h2><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);"><div style="flex:1 1 320px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">Website</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Full reorganisation of the website structure</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Fewer clicks to the main information</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Sales funnel leading visitors to the waitlist</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Blog valorised as a reason to return</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">"Un día en La Casita" interactive experience</p></div><div style="flex:1 1 320px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:24px;">SEO</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Each page optimised around its own keywords, to rank better in search.</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">SEO markup applied across all content, media included, so everything that can be searched has a chance to be found.</p><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 16px;color:oklch(24% 0.02 30);">Page copy shaped for a better reading experience for parents.</p></div></div></div></section><section style="background:oklch(97% 0.012 70);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);margin-bottom:clamp(40px,6vh,72px);"><div style="flex:1 1 300px;min-width:0;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">The experience</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">Un día en La Casita</h2></div><div style="flex:2 1 460px;min-width:0;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-size:clamp(22px,2.6vw,36px);line-height:1.2;margin:0;max-width:34ch;margin-bottom:28px;max-width:30ch;">An interactive timeline that lets families walk through a full day at the school, from the morning classroom to the goodbye.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Each of the eleven stops has its own photo, time and short story: the morning welcome, breakfast, an assembly where the children greet each other in Spanish and English, project work, time in the garden and Ecogarden, psychomotricity, lunch, nap, free play, snack and goodbye. Visitors move with the arrows or jump straight to a time.</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Some stops lead to deeper content on the same page: the facilities, the story of the school's trees and the dining room.</p></div></div><div style="position:relative;background:radial-gradient(ellipse 80% 70% at 50% 0%, oklch(90% 0.04 75), oklch(93% 0.015 60));padding:clamp(32px,6vw,80px) clamp(16px,5vw,64px) clamp(28px,5vw,56px);"><div class="mk-imac"><div class="body"><div class="screen"><div class="scroller" style="--d:50s;"><img loading="lazy" decoding="async" src="../../uploads/cs/lce_full.jpg" alt="Full-page screenshot of lacasitabilingual.com/experiencia-en-la-casita"></div></div><div class="chin"><i></i></div></div><div class="neck"></div><div class="foot"></div></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:clamp(16px,2vw,24px);margin-top:clamp(16px,2vw,24px);"><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">lacasitabilingual.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/lce_timeline.jpg" alt="Screenshot of lacasitabilingual.com"></div><div class="mk-win"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">lacasitabilingual.com</span></div><img loading="lazy" decoding="async" src="../../uploads/cs/lce_trees.jpg" alt="Screenshot of lacasitabilingual.com"></div></div><div style="margin-top:clamp(40px,6vh,72px);max-width:62ch;"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(22px,2.2vw,30px);color:oklch(33% 0.14 17);margin:0 0 12px;">The story continues below the timeline</p><p style="font-size:clamp(16px,1.4vw,18px);line-height:1.65;margin:0 0 18px;color:oklch(28% 0.01 30);max-width:60ch;">Doña Carmen and Don Rodrigo, the two centuries-old olive trees that were the first residents of the school, help the children learn respect, empathy and care for shared spaces. The page goes on with the facilities, set in an 800 m² garden, the dining room and its Mediterranean-diet menu, the school uniform and the school diary. It is in Spanish and ends with a link to the waiting list.</p></div></div></section><section style="background:oklch(93% 0.015 60);padding:clamp(72px,12vh,140px) 0;"><div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(38% 0.07 20);margin:0;margin-bottom:20px;">Before &amp; after</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,64px);line-height:1.02;letter-spacing:-0.01em;margin:0 0 clamp(24px,3vw,40px);">What changed.</h2><div style="margin-bottom:clamp(40px,6vh,72px);"><p style="font-family:'Newsreader Variable','Newsreader',serif;font-style:italic;font-size:clamp(22px,2.2vw,30px);color:oklch(33% 0.14 17);margin:0 0 16px;">Homepage</p><div style="display:flex;flex-wrap:wrap;gap:clamp(16px,2vw,24px);"><div styl