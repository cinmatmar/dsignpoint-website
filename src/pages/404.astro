---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | DsignPoint" description="This page doesn't exist. Head back to the DsignPoint homepage." path="/404/" noindex>
  <section style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 24px;background:oklch(24% 0.11 15);color:oklch(97% 0.012 70);">
    <p style="font-family:monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 18px;">404</p>
    <h1 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(34px,5vw,64px);line-height:1.05;margin:0 0 22px;">This page took a different direction.</h1>
    <p style="font-size:17px;line-height:1.6;margin:0 0 32px;color:oklch(88% 0.015 60);max-width:44ch;">The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
    <a href={import.meta.env.BASE_URL} style="display:inline-flex;gap:12px;padding:16px 28px;background:oklch(83% 0.05 80);color:oklch(15% 0.01 30);font-size:13px;letter-spacing:0.08em;text-transform:uppercase;">Back to the homepage <span aria-hidden="true">→</span></a>
  </section>
</Layout>
