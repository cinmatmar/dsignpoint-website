---
import Layout from '../../layouts/Layout.astro';

const ld = [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dsignpoint.com/"}, {"@type": "ListItem", "position": 2, "name": "Insights", "item": "https://dsignpoint.com/insights/"}]}];
---
<Layout title="Insights | DsignPoint" description="Ideas on strategy, brand and growth from DsignPoint: how we think about positioning, offers and what your business needs next." path="/insights/"    jsonld={ld}>


<div style="position:relative;overflow-x:hidden;">
<section style="position:relative;min-height:min(72vh,700px);display:flex;flex-direction:column;color:oklch(97% 0.012 70);overflow:hidden;background:oklch(18% 0.04 20);"><img src="../uploads/bn_insights.webp" alt="Woman writing in a notebook on a sunlit terrace with sea views" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;"><div style="position:absolute;inset:0;background:linear-gradient(180deg, oklch(15% 0.05 20 / 0.40) 0%, oklch(15% 0.05 20 / 0.18) 40%, oklch(12% 0.06 18 / 0.92) 100%);"></div>
    <div style="position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:18px clamp(20px,5vw,56px);width:100%;max-width:1200px;margin:0 auto;">
      <a href=".." class="dp-logo" aria-label="DsignPoint home"><span style="display:flex;align-items:center;gap:12px;"><img src="../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:48px;width:auto;display:block;"><img src="../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:24px;width:auto;display:block;"></span></a>
      <button type="button" class="dp-burger" aria-label="Open menu" aria-expanded="false" aria-controls="dp-nav"><span></span><span></span></button><div id="dp-nav" role="navigation" aria-label="Main" class="dp-nav-links" style="display:flex;align-items:center;gap:clamp(14px,2vw,30px);font-size:13px;letter-spacing:0.06em;text-transform:uppercase;">
        <a href=".." style="color:oklch(88% 0.015 60);">Home</a>
        <a href="../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
        <a href="../case-studies/" style="color:oklch(88% 0.015 60);">Case Studies</a>
        <a href="./" style="color:oklch(88% 0.015 60);">Insights</a>
        <a href="../about/" style="color:oklch(88% 0.015 60);">About</a>
        <a href="../book-a-call/" style="display:inline-flex;align-items:center;gap:10px;border:1px solid oklch(83% 0.05 80);background:oklch(83% 0.05 80);color:oklch(24% 0.11 15);padding:12px 24px;font-weight:600;box-shadow:0 8px 28px oklch(83% 0.05 80 / 0.35);transition:background 0.35s ease, border-color 0.35s ease, gap 0.35s ease;" class="h1">Book a call <span aria-hidden="true">→</span></a>
      </div>
    </div>


<div style="position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(72px,12vh,140px) clamp(20px,5vw,56px) clamp(32px,5vh,64px);width:100%;max-width:1200px;margin:0 auto;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(83% 0.05 80);margin:0 0 24px;">Insights</p><h1 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(34px,4.8vw,68px);line-height:1.0;letter-spacing:-0.01em;margin:0 0 24px;max-width:20ch;">How we think about growth.</h1><p style="font-size:clamp(15px,1.4vw,18px);line-height:1.55;margin:0 0 28px;max-width:52ch;color:oklch(88% 0.015 60);">Notes on positioning, brand and digital growth, for founders whose business has outgrown what worked.</p></div>
</section>
<section style="background:oklch(97% 0.012 70);padding:clamp(56px,9vh,110px) 0 clamp(72px,11vh,130px);"><div style="width:100%;max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);"><div style="display:flex;flex-wrap:wrap;gap:clamp(24px,4vw,72px);align-items:center;margin-bottom:clamp(56px,9vw,120px);"><a class="img-z" href="start-with-your-business/" style="flex:1 1 420px;aspect-ratio:4/3;"><img loading="lazy" decoding="async" src="../uploads/ins_start.webp" alt="A notebook with hand-drawn sketches, coffee and glasses on a sunlit terrace table by the sea" style="object-position:center 70%;"></a><div style="flex:1 1 360px;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(52% 0.09 70);margin:0 0 24px;">Our approach · 5 min read</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(30px,3.8vw,52px);line-height:1.04;letter-spacing:-0.01em;margin:0 0 20px;"><a class="ttl" href="start-with-your-business/">We don’t start with your brand. We start with your business.</a></h2><p style="font-size:17px;line-height:1.65;color:oklch(28% 0.02 30);margin:0 0 30px;max-width:44ch;">Most agencies begin with a service request. We begin with a question about your business. Here’s why, and what it changes about the way we work.</p><a class="rd" href="start-with-your-business/">Read the article <span aria-hidden="true">→</span></a></div></div><div style="display:flex;flex-direction:row-reverse;flex-wrap:wrap;gap:clamp(24px,4vw,72px);align-items:center;margin-bottom:0;"><a class="img-z" href="outgrown-your-brand/" style="flex:1 1 420px;aspect-ratio:4/3;"><img loading="lazy" decoding="async" src="../uploads/ins_outgrown.webp" alt="Old printed brand materials beside fresh burgundy and champagne colour swatches on a sunlit table" style="object-position:center 62%;"></a><div style="flex:1 1 360px;"><p style="font-family:monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:oklch(52% 0.09 70);margin:0 0 24px;">Brand & positioning · 4 min read</p><h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(30px,3.8vw,52px);line-height:1.04;letter-spacing:-0.01em;margin:0 0 20px;"><a class="ttl" href="outgrown-your-brand/">Have you outgrown your brand?</a></h2><p style="font-size:17px;line-height:1.65;color:oklch(28% 0.02 30);margin:0 0 30px;max-width:44ch;">Your brand wasn’t wrong when you built it. But the business may have moved on. Six signs the gap is real, and what to do before you commission anything.</p><a class="rd" href="outgrown-your-brand/">Read the article <span aria-hidden="true">→</span></a></div></div></div></section>
<section style="position:relative;min-height:70vh;display:flex;align-items:center;justify-content:center;color:oklch(97% 0.012 70);text-align:center;overflow:hidden;">
    <img loading="lazy" decoding="async" src="../uploads/CTA-section-bg.webp" alt="Colleagues reviewing work together at a café table, backlit by evening light" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 40%, oklch(30% 0.13 17 / 0.4), oklch(12% 0.07 18 / 0.88));"></div>
    <div style="position:relative;max-width:820px;padding:0 clamp(20px,5vw,56px);">
      <h2 style="font-family:'Newsreader Variable','Newsreader',serif;font-weight:400;font-size:clamp(36px,6vw,80px);margin:0 0 28px;">Maybe it's time to find out.</h2>
      <p style="font-size:clamp(16px,1.6vw,19px);line-height:1.6;margin:0 auto 40px;max-width:46ch;color:oklch(90% 0.015 40);">Tell us where your business is today, where you want to take it, and what's not quite fitting anymore.</p>
      <a href="../book-a-call/" style="display:inline-flex;align-items:center;gap:12px;background:oklch(97% 0.012 70);color:oklch(33% 0.14 17);padding:17px 36px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;font-weight:500;transition:background 0.35s ease, gap 0.35s ease;" class="h2">Let's talk <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <footer style="background:oklch(15% 0.01 30);color:oklch(88% 0.015 60);padding:clamp(48px,8vh,80px) clamp(20px,5vw,56px) 32px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="dp-fgrid" style="display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:clamp(24px,4vw,40px);padding-bottom:48px;border-bottom:1px solid oklch(30% 0.02 30);">
        <div>
          <a href=".."><span style="display:flex;align-items:center;gap:11px;margin-bottom:18px;"><img loading="lazy" decoding="async" src="../uploads/DP-icon-yvoir-cropped.png" alt="" style="height:42px;width:auto;display:block;"><img loading="lazy" decoding="async" src="../uploads/DP-wordmark-yvoir-cropped.png" alt="DsignPoint" style="height:21px;width:auto;display:block;"></span></a>
          <p style="font-size:14px;line-height:1.6;margin:0;color:oklch(70% 0.015 55);max-width:28ch;">A strategic business, brand and digital partner for founders whose business has outgrown its brand.</p>
        </div>
        <div>
          <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(55% 0.015 50);margin:0 0 16px;">Site</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;">
            <a href=".." style="color:oklch(88% 0.015 60);">Home</a> <a href="../approach/" style="color:oklch(88% 0.015 60);">Approach</a>
            <a href="../case-studies/" style="color:oklch(88% 0.015 60);">Case Studies</a>
            <a href="./" style="color:oklch(88% 0.015 60);">Insights</a>
            <a href="../about/" style="color:oklch(88% 0.015 60);">About</a>
          </div>
        </div>
        <div>
          <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(55% 0.015 50);margin:0 0 16px;">Contact</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;">
            <a href="tel:+34644844692" style="color:oklch(88% 0.015 60);">+34 644 84 46 92</a>
            <a href="mailto:info@dsignpoint.com" style="color:oklch(88% 0.015 60);">info@dsignpoint.com</a>
            <span style="color:oklch(70% 0.015 55);">Torrevieja, Spain</span>
            <span style="color:oklch(55% 0.015 50);font-size:13px;">FR · EN · ES · PT</span>
          </div>
        </div>
        <div>
          <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:oklch(55% 0.015 50);margin:0 0 16px;">Follow</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;">
            <a href="https://www.instagram.com/dsignpoint" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">Instagram</a>
            <a href="https://www.facebook.com/dsignpoint" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">Facebook</a>
            <a href="https://www.linkedin.com/company/dsignpoint/" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://www.youtube.com/@cindymateus" style="color:oklch(88% 0.015 60);" target="_blank" rel="noopener">YouTube</a>
          </div>
        </div>
      </div>
      <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:24px;font-size:12px;color:oklch(50% 0.015 45);">
        <span>DSIGNPOINT © 2026 ALL RIGHTS RESERVED</span>
        <div style="display:flex;gap:20px;">
          <a href="../privacy-policy/" style="color:oklch(50% 0.015 45);">Privacy Policy</a>
          <a href="../terms-and-conditions/" style="color:oklch(50% 0.015 45);">Terms &amp; Conditions</a>
          <a href="#" data-cc-open style="color:oklch(50% 0.015 45);">Cookie settings</a>
        </div>
      </div>
    </div>
  </footer>
</div>


<style is:global>
  .tile{position:relative;display:block;overflow:hidden;color:oklch(97% 0.012 70);}
  .tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1);}
  .tile:hover img{transform:scale(1.05);}
  .tile:hover{color:oklch(97% 0.012 70);}
  .lnk:hover{color:oklch(97% 0.012 70) !important;border-color:oklch(97% 0.012 70) !important;}
  .tile .arrow{display:inline-block;transition:transform .4s ease;}
  .tile:hover .arrow{transform:translateX(8px);}
  .tile .more{opacity:0;transform:translateY(8px);transition:opacity .5s ease, transform .5s ease;}
  .tile:hover .more{opacity:1;transform:none;}
  @media (hover:none){.tile .more{opacity:1;transform:none;}}
  .mcol{flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:clamp(16px,2vw,28px);}
  .ttl{color:oklch(17% 0.014 30);}
  .ttl:hover{color:oklch(33% 0.14 17);}
  .img-z{position:relative;display:block;overflow:hidden;}
  .img-z img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1);}
  .img-z:hover img{transform:scale(1.04);}
  .rd{display:inline-flex;align-items:center;gap:10px;font-size:13px;letter-spacing:0.08em;text-transform:uppercase;font-weight:500;color:oklch(33% 0.14 17);border-bottom:1px solid oklch(33% 0.14 17);padding-bottom:6px;transition:gap .35s ease;}
  .rd:hover{gap:18px;color:oklch(33% 0.14 17);}
  .art p,.art h2{margin-left:0;margin-right:0;}
.h1:hover{background:oklch(97% 0.012 70) !important;border-color:oklch(97% 0.012 70) !important;color:oklch(33% 0.14 17) !important;gap:16px !important}.h2:hover{background:oklch(83% 0.05 80) !important;gap:18px !important}</style>
</Layout>
