.h1:hover{background:oklch(97% 0.012 70) !important;border-color:oklch(97% 0.012 70) !important;color:oklch(33% 0.14 17) !important;gap:16px !important}.h2:hover{background:oklch(83% 0.05 80) !important;gap:18px !important}</style>
